<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Outbound HTTPS/WSS to the Hermes dashboard. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The RFC 8252 loopback redirect listener needs to accept a local
	     inbound connection from the system browser. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Speech dictation and audio recording use the microphone input. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
